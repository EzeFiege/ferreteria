# Conexión de administración (solo para ejecutar pnpm db:migrate)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ferreteria

# Conexión de la API (usa el rol app_user sin superuser ni bypassrls)
APP_DATABASE_URL=postgresql://app_user:app_password@localhost:5432/ferreteria
APP_USER_PASSWORD=app_password

# Servidor API
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Frontend Web (apunta a la URL pública de la API en producción)
VITE_API_URL=http://localhost:3000
